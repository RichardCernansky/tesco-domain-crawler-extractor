{
  "site": "tesco",
  "start_url": "https://www.tesco.com/groceries/en-GB/shop/fresh-food/all",
  "max_pages": 2500,
  "products_output_path": "data/products.ndjson",
  "eval_report_path": "data/eval_report.ndjson",
  "category": {
    "product_url_regex": "/groceries/en-GB/products/",
    "href_hints": ["/groceries/en-GB/"],
    "exclude_regex": "(help|account|login|privacy|terms|recipes|clubcard|basket|checkout|favourites)",
   "next_button_regex": "aria-label=[\"\\']Next page[\"\\'][^>]*href=[\"\\']([^\"\\']+)[\"\\']"
  },

  "product": {
    "name_regex": "data-auto=[\"']pdp-product-title[\"'][^>]*>(.*?)</h1>",
    "price_regex": "(?:class=[\"'][^\"']*priceText[^\"']*[\"'][^>]*>|data-auto=[\"']price-value[\"'])[^£€]*([£€])\\s*([0-9]+(?:\\.[0-9]{1,2})?)",
    "brand_regex_aria": "aria-label=\\\"Navigate to\\s+([^\\\"]+)\\s+brand page\\\"",
    "brand_regex_facet": "facetsArgs=brands%3A([A-Za-z0-9%\\-]+)",
    "ingredients_regex": "(?is)<h3[^>]*>\\s*Ingredients\\s*</h3>\\s*<div[^>]*>(.*?)</div>",
    "price_capture_groups": [1, 2],
    "flags": ["I", "S"]
  }
}
