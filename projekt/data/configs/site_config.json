{
  "site": "tesco",
  "start_url": "https://www.tesco.com/groceries/en-GB",
  "max_pages": 1001,
  "regexes": {
    "body_regex": "<body\\b[^>]*>(.*?)</body\\s*>",
    "href_regex": "href=[\"']([^\"']+)[\"']",
    "href_filter_tesco": "(?i)^https?://(?:www\\.)?tesco\\.com/groceries/en-GB",
    "name_regex": "data-auto=[\"']pdp-product-title[\"'][^>]*>(.*?)</h1>",
    "price_regex": "(?:class=[\"'][^\"']*priceText[^\"']*[\"'][^>]*>|data-auto=[\"']price-value[\"'])[^£€]*([£€])\\s*([0-9]+(?:\\.[0-9]{1,2})?)",
    "brand_regex_aria": "aria-label=\\\"Navigate to\\s+([^\\\"]+)\\s+brand page\\\"",
    "brand_regex_facet": "facetsArgs=brands%3A([A-Za-z0-9%\\-]+)",
    "ingredients_regex": "(?is)<h3[^>]*>\\s*Ingredients\\s*</h3>\\s*<div[^>]*>(.*?)</div>",
    "category_regex": "Fresh Food</a>\\s*(?:<[^>]*>\\s*)*<a[^>]*>([^<]+)</a>",
    "description_regex": "<h3[^>]*>\\s*Description\\s*</h3>\\s*(.*?)\\s*(?=<h3[^>]*>\\s*Ingredients\\b)",
    "description_lines_regex": "<span[^>]*>(.*?)</span>",
    "price_capture_groups": [1, 2],
    "flags": ["I", "S"]
  }
}
